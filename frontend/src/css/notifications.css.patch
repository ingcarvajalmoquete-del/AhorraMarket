
/* ==========================================================================
   AHORRA MARKET · NOTIFICACIONES PROFESIONALES
   Adaptación del patrón visual de Rukada sin alterar la arquitectura.
   ========================================================================== */

.notif-panel{
    width:min(390px, calc(100vw - 28px));
    max-height:min(520px, calc(100vh - 90px));
    padding:0;
    overflow:hidden;
    border-radius:16px;
    background:var(--surface);
    border:1px solid var(--line);
    box-shadow:0 24px 70px rgba(11,16,38,.22);
}

.notif-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    padding:15px 16px 13px;
    border-bottom:1px solid var(--line-2);
    background:linear-gradient(180deg,var(--surface),var(--bg));
}

.notif-head strong{
    display:block;
    font-family:Poppins,Inter,sans-serif;
    font-size:13.5px;
    font-weight:600;
    color:var(--ink);
}

.notif-head small{
    display:block;
    margin-top:2px;
    color:var(--muted);
    font-size:10.5px;
}

.notif-mark-all,
.notif-footer button{
    border:0;
    background:transparent;
    color:var(--g-700);
    font:600 10.5px/1.2 Inter,sans-serif;
    cursor:pointer;
    padding:5px 4px;
}

.notif-mark-all:hover,
.notif-footer button:hover{
    color:var(--g-900);
    text-decoration:underline;
}

.notif-list{
    position:relative;
    max-height:390px;
    overflow-y:auto;
    padding:7px;
    scrollbar-width:thin;
}

.notif-item{
    position:relative;
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:11px 10px;
    margin:1px 0;
    border-radius:11px;
    border:1px solid transparent;
    transition:background .16s ease,border-color .16s ease,transform .16s ease;
}

.notif-item:hover{
    background:var(--line-2);
    border-color:var(--line);
    transform:translateY(-1px);
}

.notif-item.is-unread{
    background:color-mix(in srgb, var(--g-50) 68%, var(--surface));
}

.notif-item.is-seen{
    opacity:.78;
}

.notif-icon{
    width:34px;
    height:34px;
    flex:none;
    display:grid;
    place-items:center;
    border-radius:10px;
    font-size:13px;
    font-weight:700;
    background:var(--g-50);
    color:var(--g-700);
    border:1px solid var(--g-100);
}

.notif-content{
    min-width:0;
    flex:1;
}

.notif-content b{
    display:block;
    color:var(--ink);
    font-size:12px;
    line-height:1.35;
    font-weight:650;
}

.notif-content small{
    display:block;
    color:var(--muted);
    font-size:10.8px;
    line-height:1.4;
    margin-top:2px;
}

.notif-content time{
    display:block;
    color:var(--muted-2);
    font-size:9.5px;
    margin-top:4px;
}

.notif-unread{
    width:7px;
    height:7px;
    flex:none;
    margin-top:5px;
    border-radius:50%;
    background:var(--g-600);
    box-shadow:0 0 0 3px color-mix(in srgb, var(--g-100) 65%, transparent);
}

.notif-warning .notif-icon{
    background:var(--amber-bg);
    color:var(--amber);
    border-color:#f6e3bd;
}

.notif-danger .notif-icon{
    background:var(--red-bg);
    color:var(--red);
    border-color:#f7d8d8;
}

.notif-success .notif-icon{
    background:var(--g-50);
    color:var(--g-700);
    border-color:var(--g-100);
}

.notif-info .notif-icon{
    background:var(--blue-bg);
    color:var(--blue);
    border-color:#d7e3fb;
}

.notif-footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:9px 13px;
    border-top:1px solid var(--line-2);
    color:var(--muted-2);
    font-size:9.5px;
    background:var(--bg);
}

.notif-panel.is-loading .notif-list{
    opacity:.55;
    pointer-events:none;
}

@media(max-width:640px){
    .notif-panel{
        position:fixed;
        top:64px;
        right:14px;
        width:min(390px, calc(100vw - 28px));
        max-height:calc(100vh - 80px);
    }

    .notif-list{
        max-height:calc(100vh - 185px);
    }
}

[data-theme="dark"] .notif-panel{
    box-shadow:0 24px 70px rgba(0,0,0,.48);
}

[data-theme="dark"] .notif-head{
    background:linear-gradient(180deg,var(--surface),var(--bg));
}

[data-theme="dark"] .notif-item.is-unread{
    background:color-mix(in srgb, var(--g-900) 18%, var(--surface));
}
